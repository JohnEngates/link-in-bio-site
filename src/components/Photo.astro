---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  width?: number;
  eager?: boolean;
  sizes?: string;
  /** Click to open the full-size photo in the viewer. On by default. */
  zoom?: boolean;
}
const {
  src,
  alt,
  caption,
  class: cls = '',
  width = 1200,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 560px',
  zoom = true,
} = Astro.props;
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
// The viewer shows the photo uncropped, at up to 2000px wide and never upscaled.
const full = zoom
  ? await getImage({ src, width: Math.min(2000, src.width), quality: 84 })
  : null;
---

<figure class={`photo ${cls}`}>
  {
    full ? (
      <a
        class="zoom"
        href={full.src}
        data-zoom
        data-w={full.attributes.width}
        data-h={full.attributes.height}
        data-caption={caption ?? ''}
        aria-label={`View larger: ${alt}`}
      >
        <Image
          src={src}
          alt={alt}
          width={Math.min(width, src.width)}
          widths={widths.length ? widths : [src.width]}
          sizes={sizes}
          quality={80}
          loading={eager ? 'eager' : 'lazy'}
        />
      </a>
    ) : (
      <Image
        src={src}
        alt={alt}
        width={Math.min(width, src.width)}
        widths={widths.length ? widths : [src.width]}
        sizes={sizes}
        quality={80}
        loading={eager ? 'eager' : 'lazy'}
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
