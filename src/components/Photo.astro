---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  width?: number;
  eager?: boolean;
  sizes?: string;
}
const {
  src,
  alt,
  caption,
  class: cls = '',
  width = 1200,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 560px',
} = Astro.props;
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---

<figure class={`photo ${cls}`}>
  <Image
    src={src}
    alt={alt}
    width={Math.min(width, src.width)}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    quality={80}
    loading={eager ? 'eager' : 'lazy'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
